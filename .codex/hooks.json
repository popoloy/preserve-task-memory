{
  "description": "Automatically preserve and recover durable task state around Codex activity and context compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=require('node:fs'),p=require('node:path');let r=process.cwd(),s;for(;;){s=p.join(r,'.agents','skills','preserve-task-memory','scripts','hook-runner.cjs');if(f.existsSync(s))break;const q=p.dirname(r);if(q===r)throw Error('preserve-task-memory not found');r=q}require(s)\"",
            "statusMessage": "Recovering durable task memory",
            "additionalContextLimit": 1800,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=require('node:fs'),p=require('node:path');let r=process.cwd(),s;for(;;){s=p.join(r,'.agents','skills','preserve-task-memory','scripts','hook-runner.cjs');if(f.existsSync(s))break;const q=p.dirname(r);if(q===r)throw Error('preserve-task-memory not found');r=q}require(s)\"",
            "statusMessage": "Saving the latest task request",
            "additionalContextLimit": 250,
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=require('node:fs'),p=require('node:path');let r=process.cwd(),s;for(;;){s=p.join(r,'.agents','skills','preserve-task-memory','scripts','hook-runner.cjs');if(f.existsSync(s))break;const q=p.dirname(r);if(q===r)throw Error('preserve-task-memory not found');r=q}require(s)\"",
            "statusMessage": "Recording task activity",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=require('node:fs'),p=require('node:path');let r=process.cwd(),s;for(;;){s=p.join(r,'.agents','skills','preserve-task-memory','scripts','hook-runner.cjs');if(f.existsSync(s))break;const q=p.dirname(r);if(q===r)throw Error('preserve-task-memory not found');r=q}require(s)\"",
            "statusMessage": "Saving durable task memory",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
